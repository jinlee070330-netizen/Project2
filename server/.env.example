# Copy this file to .env and fill in your own values. Never commit .env.

# From dashboard.api-football.com -> Account -> My Access
API_FOOTBALL_KEY=your_api_football_key_here

# From MongoDB Atlas -> Connect -> Drivers (replace <password>)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/h2h?retryWrites=true&w=majority

# Season used to load each league's teams. If the API says your plan
# can't access this season, try an earlier year (e.g. 2023, 2022).
SEASON=2024

PORT=4000
CLIENT_ORIGIN=http://localhost:5173
